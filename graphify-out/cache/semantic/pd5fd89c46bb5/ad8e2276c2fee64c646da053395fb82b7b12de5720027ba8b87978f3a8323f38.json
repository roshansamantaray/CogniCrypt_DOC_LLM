{"nodes": [{"id": "presentation_crysldoc_overview", "label": "CrySLDoc Presentation Overview", "file_type": "document", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_dependency_aware_prompting", "label": "Dependency-Aware Prompting", "file_type": "concept", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A secure example is generated with knowledge of its dependencies' contracts, not just its own, via a depth-limited cycle-safe DFS with explicit budgets (MAX_DEPENDENCIES, MAX_ITEMS_PER_DEP, MAX_DEP_TEXT_CHARS). This is what lets the model correctly initialise a whole object chain such as Cipher from SecretKey from KeyGenerator."}, {"id": "presentation_two_layer_grounding", "label": "Two-Layer RAG Grounding", "file_type": "concept", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cached semantics-only CrySL primer teaches the model to read the DSL itself and is built on a stable built-in scaffold so it stays consistent across runs; separately, rule-specific retrieval supplies context for the class being documented."}, {"id": "presentation_contract_shaping", "label": "Priority-Based CrySL Contract Shaping", "file_type": "concept", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prompts are bounded by drop priority rather than blind truncation: ORDER and FORBIDDEN are preserved as far as possible while ENSURES and CONSTRAINTS are dropped first, so safety-relevant rules survive even when a rule is too large to send whole."}, {"id": "presentation_compile_verified_secure_examples", "label": "Compile-Verified Secure Examples", "file_type": "concept", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated Java is compiled with real javac against the JDK alone \u2014 deliberately not the project's own classpath \u2014 so an example that compiles here also compiles for a reader who only has a JDK. On failure the compiler diagnostics drive up to 7 repair rounds; the compiler, not the model, is the arbiter of correctness."}, {"id": "presentation_deterministic_pre_repair", "label": "Deterministic Pre-Repair of Model Output", "file_type": "concept", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local repairs (import dedupe/auto-import, class-name normalisation, fence handling) run before spending an API call, so cheap deterministic fixes are never paid for with a completion."}, {"id": "presentation_graph_sanitizer_scc_collapse", "label": "GraphSanitizer with Tarjan SCC Collapse", "file_type": "concept", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collapsing strongly connected components means mutually-dependent rules still yield a stable cycle-free ordering, and a recovery heuristic rescues a start node that looks suspiciously dependency-free by checking the reverse map for candidate providers."}, {"id": "presentation_build_path_scrubbing", "label": "Build-Path Scrubbing and Two-Tier Diagnostics", "file_type": "concept", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Published pages carry a one-line failure summary with absolute paths replaced by <path>; the unabridged tracebacks go to llm_codegen_failures.txt for the maintainer. Readers never see the build machine's filesystem."}, {"id": "presentation_server_directed_backoff", "label": "Server-Directed 429 Backoff", "file_type": "concept", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parses the gateway's own 'Limit resets at:' timestamp and waits the real interval rather than guessing, handling both plain 429s and ones nested inside a 500 envelope."}, {"id": "presentation_layered_timeouts", "label": "Layered Timeout Ceilings", "file_type": "concept", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-request client timeout, client-side retries, and an outer Java wall-clock ceiling per sidecar call \u2014 the example ceiling is deliberately larger than the explanation ceiling because of the compile-and-repair loop."}, {"id": "presentation_single_source_of_truth", "label": "Single Source of Truth", "file_type": "rationale", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same CrySL rules that drive CogniCrypt's static analysis drive this documentation, so documentation cannot drift from the analyser's actual behaviour \u2014 both read the same files."}, {"id": "presentation_verification_over_trust", "label": "Verification Over Trust in LLM Output", "file_type": "rationale", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most LLM code-generation pipelines publish whatever the model returns; this one compiles it first and iterates on real compiler diagnostics, so correctness is externally checked rather than assumed."}, {"id": "presentation_clean_tier_separation", "label": "Clean Tier Separation via Process Boundaries", "file_type": "rationale", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ProcessBuilder isolation lets the Python environment change independently of the Java build and lets the LLM tier be switched off entirely for a fast, fully deterministic run."}, {"id": "presentation_graceful_degradation", "label": "Graceful Degradation Everywhere", "file_type": "rationale", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-rule try/catch during composition, per-language and per-example-type isolation during generation, and RAG failures falling back to no-context generation \u2014 a partial failure yields a slightly less rich page, never a broken run."}, {"id": "presentation_three_override_axes", "label": "Three Independent Override Axes with JAR Fallback", "file_type": "rationale", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--rulesDir (input), --ftlTemplatesPath (HTML structure) and --langTemplatesPath (sentence wording) can each be redirected to disk while the others stay bundled, so the tool is self-contained by default yet fully customisable without a rebuild."}, {"id": "presentation_placeholder_aware_caching", "label": "Placeholder-Aware Caching and Targeted Regeneration", "file_type": "concept", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "isRetryablePlaceholder and Utils.isRetryableExplanationPlaceholder distinguish a real cached answer from a failure marker, so failures are retried next run while good content is reused for free and only the missing example type is re-billed."}, {"id": "presentation_pairing_by_class_name", "label": "Page-to-Rule Pairing by Class Name", "file_type": "concept", "source_file": "Presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "createSinglePage resolves rules through cryslRuleByClassName, never by list position, so upstream reordering cannot mismatch a page with another class's state machine."}], "edges": [{"source": "presentation_crysldoc_overview", "target": "presentation_dependency_aware_prompting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Presentation.md", "source_location": null, "weight": 1.0}, {"source": "presentation_crysldoc_overview", "target": "presentation_two_layer_grounding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Presentation.md", "source_location": null, "weight": 1.0}, {"source": "presentation_crysldoc_overview", "target": "presentation_contract_shaping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Presentation.md", "source_location": null, "weight": 1.0}, {"source": "presentation_crysldoc_overview", "target": "presentation_compile_verified_secure_examples", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Presentation.md", "source_location": null, "weight": 1.0}, {"source": "presentation_crysldoc_overview", "target": "presentation_graph_sanitizer_scc_collapse", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Presentation.md", "source_location": null, "weight": 1.0}, {"source": "presentation_crysldoc_overview", "target": "presentation_build_path_scrubbing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Presentation.md", "source_location": null, "weight": 1.0}, {"source": "presentation_crysldoc_overview", "target": "presentation_server_directed_backoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Presentation.md", "source_location": null,