{"nodes": [{"id": "project_crysldoc_reference", "label": "CrySLDoc Codebase Reference", "file_type": "document", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Roshan Samantaray", "contributor": null}, {"id": "project_three_tier_architecture", "label": "Three-Tier Filesystem-Coupled Architecture", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Java, Python and FreeMarker tiers are connected only by the filesystem and OS process boundaries \u2014 there is no in-process coupling between Java and Python, so the Python environment can change independently of the Java build."}, {"id": "project_tier1_java_rule_compiler", "label": "Tier 1 \u2014 Java Rule Compiler", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_tier2_llm_sidecar", "label": "Tier 2 \u2014 Python LLM Sidecar", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_tier3_freemarker_renderer", "label": "Tier 3 \u2014 FreeMarker HTML Renderer", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_composedrule_dto", "label": "ComposedRule \u2014 The Central DTO", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 24-field logic-free DTO deliberately used as the single contract between rule analysis, LLM generation and HTML rendering. Its string fields already contain HTML markup produced by the sentence generators, which templates render unescaped and which is also forwarded into LLM prompts."}, {"id": "project_twelve_sentence_generators", "label": "Twelve CrySL Sentence Generators", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_predicate_dependency_trees", "label": "Predicate Dependency Ordering and Trees", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_sanitized_rule_json", "label": "Two-Stage Sanitized Rule JSON", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written by Java and read by Python, it is the only cross-language data contract. Sanitization strips HTML, expands tooltips, dedupes lists, confines I/O under a base directory and caps input at 2 MB, so the Python side always receives a predictable schema."}, {"id": "project_explanation_cache_poisoning", "label": "Explanation Cache Poisoning", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyed by filename with only a Files.exists check, so a failure placeholder written by a keyless run is pinned into the documentation forever. Contrast with the code-example path, which recognises retryable placeholder text and regenerates."}, {"id": "project_rag_paper_index", "label": "FAISS RAG Index over the CrySL Paper", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache key is sha256(provider|model|abs pdf path|size:mtime) so switching provider or embedding model produces a separate index rather than silently mixing incompatible vector spaces \u2014 the only content-derived, revalidated cache in the project."}, {"id": "project_dual_llm_backends", "label": "Dual LLM Backends \u2014 OpenAI and UPB AI-Gateway", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No fallback between backends occurs; --llm-backend fully determines which is used. Known asymmetry: OPENAI_CHAT_MODEL/OPENAI_EMB_MODEL affect the example writers but are silently ignored by the explanation writer."}, {"id": "project_gateway_rate_limiter", "label": "Cross-Process Gateway Rate Limiter", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A JSON timestamp file guarded by fcntl.flock or msvcrt.locking with atomic temp-file-rename writes. It exists because the state file must be process-durable across two separate crysldoc invocations, not because the pipeline itself parallelizes."}, {"id": "project_no_concurrency_model", "label": "Deliberate Absence of a Concurrency Model", "file_type": "rationale", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero threads, executors, parallel streams or synchronization anywhere; subprocesses are spawned strictly one at a time. Idempotency is cache-based, not transactional, so a killed run resumes from whatever files exist. Landmine: Order.java keeps three static scratch fields cleared in a finally block, safe only because rules are processed sequentially."}, {"id": "project_error_handling_by_layer", "label": "Error-Handling Philosophy by Layer", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three distinct styles coexist: CLI exits 255, rule loading tolerates partial failure, sentence generation throws uncaught, LLM generation substitutes placeholders and never aborts, cache writes deliberately swallow IOException. There is no top-level handler around the pipeline."}, {"id": "project_wrong_state_machine_diagram_issue", "label": "Known Issue \u2014 Every Page Renders the Wrong State-Machine Diagram", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Traced to commit 5c7158a ('Sort sidebar alphabetical', 2024-08-05), which post-dates the positional access added in 6a1d172. Only the diagram is wrong because all other content lives on ComposedRule and travels with the sort \u2014 which is what made it easy to miss and easy to trust."}, {"id": "project_inert_subprocess_timeout", "label": "Known Issue \u2014 60-Second Subprocess Timeout Is Inert", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The blocking readLine drain only ends at EOF, which the child produces on exit, so by the time waitFor(60s) runs the process has already finished \u2014 a hung child blocks the pipeline indefinitely with no enforced ceiling."}, {"id": "project_cross_feature_hidden_dependency", "label": "Known Issue \u2014 Examples Depend on the Explanation Path's Side Effect", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running --llm-explanations=off --llm-examples=on on a clean checkout silently degrades every example's Dependency Guarantees and Dependency Constraints sections to (none), with no warning."}, {"id": "project_dependency_graph_naming_inversion", "label": "Known Issue \u2014 Naming Inversion in the Dependency-Graph Code", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two inversions cancel out so the rendered trees are correct today; 'fixing' the argument order to match the parameter names would silently swap the trees on every page."}, {"id": "project_secure_example_compile_gate", "label": "Secure-Example javac Compile Gate", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documented here as weaker than it looks: compiling against java.class.path plus target/classes plus every jar in target/lib only proves the code avoids symbols absent from this classpath, not that it compiles for an end developer."}, {"id": "project_dead_code_inventory", "label": "Dead and Unused Code Inventory", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_boolean_toggle_flags", "label": "Seven Presentation Toggle Flags (--booleanA..G)", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_test_coverage_gap", "label": "Test Coverage Gap", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roughly 40 lines of test coverage against ~9,800 lines of application logic, with no CI anywhere. The untested highest-risk surface is exactly where nearly every High-severity finding lived: the twelve sentence generators, Order.java's regex parser, the graph algorithms and the rule-to-page pairing."}, {"id": "project_external_cdn_dependencies", "label": "Render-Critical CDN Dependencies with No Offline Fallback", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every generated page loads d3, @hpcc-js/wasm, d3-graphviz from unpkg and marked from jsdelivr. Offline the diagram never renders and explanations show raw markdown, while collapsible sections still work because that logic has no external dependency."}, {"id": "project_author_attribution", "label": "Author Attribution and Repository History", "file_type": "concept", "source_file": "PROJECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ritika Singh and Sven Feldmann built the original template-based pipeline (2021-2024); Roshan Samantaray added the LLM integration (2025-2026). Michael Schlichtig and Andr\u00e9 Sonntag made smaller earlier contributions."}], "edges": [{"source": "project_crysldoc_reference", "target": "project_three_tier_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT.md", "source_location": null, "weight": 1.0}, {"source": "project_three_tier_architecture", "target": "project_tier1_java_rule_compiler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT.md", "source_location": null, "weight": 1.0}, {"source": "project_three_tier_architecture", "target": "project_tier2_llm_sidecar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT.md", "source_location": null, "weight": 1.0}, {"source": "project_three_tier_architecture", "target": "project_tier3_freemarker_renderer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT.md", "source_location": null, "weight": 1.0}, {"source": "project_tier1_java_rule_compiler", "target": "project_twelve_sentence_generators", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT.md", "source_