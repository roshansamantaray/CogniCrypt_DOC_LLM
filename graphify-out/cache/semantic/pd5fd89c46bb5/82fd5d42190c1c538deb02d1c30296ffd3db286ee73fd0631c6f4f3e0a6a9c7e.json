{"nodes": [{"id": "tse19crysl_paper", "label": "CrySL: An Extensible Approach to Validating the Correct Usage of Cryptographic APIs", "file_type": "paper", "source_file": "tse19CrySL.pdf", "source_location": "IEEE Transactions on Software Engineering, DOI 10.1109/TSE.2019.2948910", "source_url": null, "captured_at": null, "author": "Stefan Kr\u00fcger, Johannes Sp\u00e4th, Karim Ali, Eric Bodden, Mira Mezini", "contributor": null}, {"id": "tse19crysl_crysl_language", "label": "CrySL Specification Language", "file_type": "concept", "source_file": "tse19CrySL.pdf", "source_location": "\u00a73 CrySL Syntax", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designed to bridge the cognitive gap between cryptography experts and developers: white-listing secure usage rather than black-listing misuse, deliberately lightweight and Java-like syntax so crypto experts need no analysis expertise, and equipped with tool-independent semantics so the same rules can drive documentation, code generation and dynamic checking as well as static analysis."}, {"id": "tse19crysl_cognicrypt_sast", "label": "CogniCryptSAST \u2014 CrySL-Parameterizable Static Analysis", "file_type": "concept", "source_file": "tse19CrySL.pdf", "source_location": "\u00a76 Implementation", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tse19crysl_typestate_analysis", "label": "Flow-, Field- and Context-Sensitive Typestate Analysis", "file_type": "concept", "source_file": "tse19CrySL.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tse19crysl_requires_ensures_predicates", "label": "REQUIRES/ENSURES Predicates and Rely-Guarantee Reasoning", "file_type": "concept", "source_file": "tse19CrySL.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Predicates let individual CrySL rules reference one an